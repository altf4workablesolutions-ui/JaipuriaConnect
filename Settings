import React, { useState, useEffect } from "react";
import { base44 } from "@/api/base44Client";
import { motion } from "framer-motion";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Palette, Sparkles, Sun, Moon, Loader2 } from "lucide-react";
import { toast } from "sonner";
import { createPageUrl } from "@/utils";

export default function Settings() {
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [selectedTheme, setSelectedTheme] = useState("auto");

  useEffect(() => {
    loadUser();
  }, []);

  const loadUser = async () => {
    try {
      const userData = await base44.auth.me();
      setUser(userData);
      setSelectedTheme(userData.theme_preference || "auto");
      setLoading(false);
    } catch (error) {
      base44.auth.redirectToLogin(createPageUrl("Settings"));
    }
  };

  const handleThemeChange = async (theme) => {
    setSaving(true);
    try {
      await base44.auth.updateMe({ theme_preference: theme });
      setSelectedTheme(theme);
      toast.success("Theme updated! Reloading to apply changes... 🎨");
      
      setTimeout(() => {
        window.location.reload();
      }, 800);
    } catch (error) {
      toast.error("Failed to update theme");
      setSaving(false);
    }
  };

  const getCurrentFestival = () => {
    const now = new Date();
    const month = now.getMonth() + 1;
    const day = now.getDate();

    if ((month === 10 && day >= 20) || (month === 11 && day <= 15)) {
      return { name: "Diwali", emoji: "🪔", colors: "from-orange-600 via-yellow-500 to-orange-600" };
    }
    if (month === 3 && day >= 1 && day <= 20) {
      return { name: "Holi", emoji: "🎨", colors: "from-pink-500 via-purple-500 to-blue-500" };
    }
    if ((month === 9 && day >= 20) || (month === 10 && day <= 15)) {
      return { name: "Durga Puja", emoji: "🙏", colors: "from-red-600 via-yellow-500 to-orange-600" };
    }
    if (month === 8 && day === 15) {
      return { name: "Independence Day", emoji: "🇮🇳", colors: "from-orange-500 via-white to-green-600" };
    }
    if (month === 1 && day === 26) {
      return { name: "Republic Day", emoji: "🇮🇳", colors: "from-orange-500 via-white to-green-600" };
    }
    if (month === 12 && day >= 20 && day <= 31) {
      return { name: "Christmas", emoji: "🎄", colors: "from-red-600 via-green-600 to-red-600" };
    }
    
    return null;
  };

  const currentFestival = getCurrentFestival();

  const themes = [
    {
      id: "auto",
      name: "Auto (Festival-Based)",
      description: "Automatically changes theme based on Indian festivals",
      icon: Sparkles,
      preview: "from-purple-400 via-pink-400 to-orange-400"
    },
    {
      id: "light",
      name: "Light Theme",
      description: "Clean and bright interface",
      icon: Sun,
      preview: "from-orange-100 via-pink-100 to-purple-100"
    },
    {
      id: "dark",
      name: "Dark Theme",
      description: "Easy on the eyes",
      icon: Moon,
      preview: "from-gray-800 via-gray-900 to-gray-800"
    },
    {
      id: "festive",
      name: "Permanent Festive",
      description: "Always celebrate with vibrant colors",
      icon: Palette,
      preview: "from-orange-500 via-yellow-400 to-pink-500"
    }
  ];

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <Loader2 className="w-12 h-12 animate-spin text-orange-600" />
      </div>
    );
  }

  return (
    <div className="min-h-screen py-16">
      <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-8"
        >
          <h1 className="text-5xl font-bold mb-4 bg-gradient-to-r from-orange-600 to-pink-600 bg-clip-text text-transparent">
            ⚙️ Theme Settings
          </h1>
          <p className="text-xl" style={{ color: 'var(--text-secondary)' }}>
            Customize your Jaipuria Blogs experience
          </p>
        </motion.div>

        {/* Current Theme Banner */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-8"
        >
          <Card className="border-2 border-blue-200 bg-blue-50">
            <CardContent className="p-4">
              <p className="text-sm text-blue-800">
                <strong>Current Theme:</strong> {selectedTheme.charAt(0).toUpperCase() + selectedTheme.slice(1)}
                {selectedTheme === "auto" && currentFestival && ` (${currentFestival.name} Active 🎉)`}
              </p>
            </CardContent>
          </Card>
        </motion.div>

        {/* Current Festival Banner */}
        {currentFestival && selectedTheme === "auto" && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="mb-8"
          >
            <Card className={`border-2 bg-gradient-to-r ${currentFestival.colors} text-white`}>
              <CardContent className="p-6">
                <div className="text-center">
                  <div className="text-6xl mb-2">{currentFestival.emoji}</div>
                  <h3 className="text-2xl font-bold">Happy {currentFestival.name}!</h3>
                  <p className="text-white/90 mt-2">
                    Special festive theme is currently active
                  </p>
                </div>
              </CardContent>
            </Card>
          </motion.div>
        )}

        {/* Theme Selection */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.2 }}
          className="space-y-4"
        >
          {themes.map((theme) => (
            <Card
              key={theme.id}
              className={`cursor-pointer transition-all hover:shadow-xl ${
                selectedTheme === theme.id
                  ? "ring-2 ring-orange-500 shadow-xl"
                  : "hover:ring-1 hover:ring-gray-300"
              } ${saving ? 'opacity-50 pointer-events-none' : ''}`}
              onClick={() => !saving && handleThemeChange(theme.id)}
            >
              <CardContent className="p-6">
                <div className="flex items-center gap-6">
                  <div className={`w-20 h-20 rounded-xl bg-gradient-to-br ${theme.preview} flex items-center justify-center shadow-lg`}>
                    <theme.icon className={`w-10 h-10 ${theme.id === 'dark' ? 'text-white' : theme.id === 'light' ? 'text-orange-600' : 'text-white'}`} />
                  </div>
                  <div className="flex-1">
                    <h3 className="text-xl font-bold mb-1 flex items-center gap-2" style={{ color: 'var(--text-primary)' }}>
                      {theme.name}
                      {selectedTheme === theme.id && (
                        <span className="text-sm bg-orange-500 text-white px-2 py-0.5 rounded-full">
                          Active
                        </span>
                      )}
                    </h3>
                    <p style={{ color: 'var(--text-secondary)' }}>{theme.description}</p>
                  </div>
                  {saving && selectedTheme === theme.id && (
                    <Loader2 className="w-5 h-5 animate-spin text-orange-600" />
                  )}
                </div>
              </CardContent>
            </Card>
          ))}
        </motion.div>

        {/* Festival Calendar Info */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.4 }}
          className="mt-8"
        >
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2" style={{ color: 'var(--text-primary)' }}>
                🎉 Festival Calendar
              </CardTitle>
              <CardDescription>
                When "Auto" theme is selected, the app automatically celebrates these festivals
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div className="grid md:grid-cols-2 gap-4">
                <div className="p-3 bg-orange-50 rounded-lg border border-orange-200">
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-2xl">🪔</span>
                    <span className="font-semibold text-gray-900">Diwali</span>
                  </div>
                  <p className="text-sm text-gray-600">October - November</p>
                </div>
                <div className="p-3 bg-pink-50 rounded-lg border border-pink-200">
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-2xl">🎨</span>
                    <span className="font-semibold text-gray-900">Holi</span>
                  </div>
                  <p className="text-sm text-gray-600">March</p>
                </div>
                <div className="p-3 bg-red-50 rounded-lg border border-red-200">
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-2xl">🙏</span>
                    <span className="font-semibold text-gray-900">Durga Puja</span>
                  </div>
                  <p className="text-sm text-gray-600">September - October</p>
                </div>
                <div className="p-3 bg-green-50 rounded-lg border border-green-200">
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-2xl">🇮🇳</span>
                    <span className="font-semibold text-gray-900">Independence & Republic Day</span>
                  </div>
                  <p className="text-sm text-gray-600">August 15 & January 26</p>
                </div>
                <div className="p-3 bg-green-50 rounded-lg border border-green-200">
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-2xl">🎄</span>
                    <span className="font-semibold text-gray-900">Christmas</span>
                  </div>
                  <p className="text-sm text-gray-600">December</p>
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>
      </div>
    </div>
  );
}
